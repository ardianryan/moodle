{{!
    Frontpage Bento Portal
    Fully dynamic based on Moodle site fullname, shortname, summary, and course records.
    No hardcoded school names or theme names.
}}
<div class="bento-page pb-4">
    <!-- —— Board 1: Hero Banner + Sambutan & Profil + Layanan Cepat (12-Col Grid) —— -->
    <div class="bento-board mb-4">
        <!-- 1. Hero Banner Tile (Col Span 12) -->
        <div class="bento-tile tone-white span-12 hero-banner-tile">
            <div class="hero-banner-inner">
                <div class="hero-banner-text">
                    <p class="bento-eyebrow">PORTAL RESMI {{ siteshortname }}</p>
                    <h1 class="hero-title">LMS {{ sitefullname }}</h1>
                    <p class="hero-desc">
                        Pusat kegiatan belajar daring, distribusi materi ajar kurikulum sekolah, dan pelaksanaan Computer-Based Test (CBT) terpadu berbasis akun tunggal {{ siteshortname }}.
                    </p>
                    <div class="hero-actions">
                        <a href="{{{ loginurl }}}" class="btn-bento-primary">
                            <i class="fa fa-sign-in mr-2"></i>Masuk dengan Akun {{ siteshortname }}
                        </a>
                        <a href="#katalog-kursus" class="btn-bento-secondary">
                            <i class="fa fa-book mr-2"></i>Lihat Kelas Terbuka
                        </a>
                    </div>
                </div>
                <div class="hero-banner-aside">
                    <div class="school-identity-box">
                        {{#sitelogourl}}
                        <img src="{{{ sitelogourl }}}" alt="{{ sitefullname }}" class="school-crest-img" onerror="this.style.display='none'">
                        {{/sitelogourl}}
                        <div class="school-text-wrap">
                            <span class="school-title">{{ sitefullname }}</span>
                            <span class="school-meta">Portal Pembelajaran Digital &bull; {{ siteshortname }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Foto Gedung / Emblem Sekolah (Col Span 4, Aspect 4:5) -->
        <div class="bento-tile tone-white span-4 tile-photo-block">
            <div class="photo-container aspect-4-5">
                <div class="photo-media-wrap">
                    {{#sitelogourl}}
                    <img src="{{{ sitelogourl }}}" alt="{{ sitefullname }}" class="photo-crest-center">
                    {{/sitelogourl}}
                </div>
                <span class="photo-badge-left">{{ siteshortname }}</span>
                <span class="photo-badge-right">LMS RESMI</span>
            </div>
        </div>

        <!-- 3. Sambutan / Ringkasan Sekolah (Col Span 4, Tone Peach) -->
        <div class="bento-tile tone-peach span-4 tile-welcome-block">
            <div>
                <p class="bento-eyebrow">PROFIL & LAYANAN</p>
                <h2 class="welcome-heading">Pembelajaran Terpadu {{ siteshortname }}</h2>
                <div class="welcome-body prose-sm">
                    {{#sitesummary}}
                        {{{ sitesummary }}}
                    {{/sitesummary}}
                    {{^sitesummary}}
                        <p>
                            LMS {{ sitefullname }} terhubung langsung dengan sistem identitas digital sekolah untuk mendampingi alur belajar harian, penyampaian modul ajar, penugasan terstruktur, dan evaluasi hasil belajar siswa.
                        </p>
                    {{/sitesummary}}
                </div>
            </div>
            <div class="welcome-footer-tag">
                <i class="fa fa-id-badge text-emerald mr-2"></i>
                <span>Terintegrasi Akun {{ siteshortname }}</span>
            </div>
        </div>

        <!-- 4. Layanan Pembelajaran Mini Tiles (Col Span 2 each) -->
        <div class="bento-tile tone-sky span-2 tile-service">
            <div class="service-icon-box text-sky">
                <i class="fa fa-book"></i>
            </div>
            <h3 class="service-title">Modul Ajar</h3>
            <p class="service-desc">Bahan bacaan, e-modul, dan materi digital per mata pelajaran.</p>
        </div>

        <div class="bento-tile tone-mint span-2 tile-service">
            <div class="service-icon-box text-emerald">
                <i class="fa fa-check-square-o"></i>
            </div>
            <h3 class="service-title">CBT & Asesmen</h3>
            <p class="service-desc">Ujian formatif dan sumatif sekolah dengan proteksi waktu.</p>
        </div>

        <div class="bento-tile tone-violet span-2 tile-service">
            <div class="service-icon-box text-violet">
                <i class="fa fa-folder-open-o"></i>
            </div>
            <h3 class="service-title">Tugas & Portofolio</h3>
            <p class="service-desc">Pengumpulan proyek mandiri dan rekam capaian belajar.</p>
        </div>

        <div class="bento-tile tone-amber span-2 tile-service">
            <div class="service-icon-box text-amber">
                <i class="fa fa-shield"></i>
            </div>
            <h3 class="service-title">Akses Akun</h3>
            <p class="service-desc">Satu akun resmi terpadu untuk seluruh layanan {{ siteshortname }}.</p>
        </div>
    </div>

    <!-- —— Board 2: Warta & Aktivitas Pembelajaran (12-Col Grid) —— -->
    <div class="section-row-header mt-4 mb-3">
        <div>
            <p class="bento-eyebrow">AKTIVITAS & KELAS</p>
            <h2 class="bento-section-title">Yang Sedang Aktif di {{ siteshortname }}</h2>
        </div>
        <a href="https://portal.sman1gedeg.sch.id" target="_blank" rel="noopener noreferrer" class="btn-bento-text">
            <span>Buka Portal Utama</span>
            <i class="fa fa-arrow-right ml-1"></i>
        </a>
    </div>

    <div class="bento-board mb-5">
        {{#featuredcourse}}
        <!-- Featured Course / Article (Col Span 7, Dynamic from Course Record) -->
        <div class="bento-tile tone-white span-7 tile-featured-article">
            <a href="{{{ viewurl }}}" class="featured-article-link">
                <div class="featured-cover-wrap">
                    <img src="{{{ imageurl }}}" alt="{{ fullname }}" class="featured-cover-img" onerror="this.src='{{{ sitelogourl }}}'">
                    <div class="featured-cover-overlay"></div>
                    <div class="featured-cover-caption">
                        <div class="caption-badges mb-2">
                            <span class="badge-cat badge-cat-emerald">{{ shortname }}</span>
                            <span class="caption-date">Kelas Aktif</span>
                        </div>
                        <h3 class="featured-caption-title">
                            {{ fullname }}
                        </h3>
                        <p class="featured-caption-excerpt">
                            {{ summary }}
                        </p>
                    </div>
                </div>
            </a>
        </div>
        {{/featuredcourse}}
        {{^featuredcourse}}
        <!-- Fallback Featured Block if no courses yet -->
        <div class="bento-tile tone-white span-7 tile-featured-article">
            <div class="featured-cover-wrap">
                <img src="{{{ sitelogourl }}}" alt="{{ sitefullname }}" class="featured-cover-img">
                <div class="featured-cover-overlay"></div>
                <div class="featured-cover-caption">
                    <div class="caption-badges mb-2">
                        <span class="badge-cat badge-cat-emerald">Akademik</span>
                        <span class="caption-date">Tahun Ajaran Aktif</span>
                    </div>
                    <h3 class="featured-caption-title">
                        Platform Pembelajaran Mandiri {{ sitefullname }}
                    </h3>
                    <p class="featured-caption-excerpt">
                        Seluruh aktivitas modul ajar, penugasan terstruktur, dan ujian berbasis komputer terpusat di LMS ini.
                    </p>
                </div>
            </div>
        </div>
        {{/featuredcourse}}

        <!-- Stacked Side Articles (Col Span 5, 3 Mini Cards) -->
        <div class="span-5 side-articles-col">
            <div class="bento-tile tone-sky tile-side-article">
                <div class="side-thumb-wrap">
                    <div class="side-thumb-fallback bg-sky">
                        <i class="fa fa-laptop"></i>
                    </div>
                </div>
                <div class="side-article-body">
                    <div class="side-meta mb-1">
                        <span class="badge-cat badge-cat-sky">Akademik</span>
                        <span class="meta-date">Kurikulum</span>
                    </div>
                    <h4 class="side-article-title">
                        Pelaksanaan Asesmen Berbasis Komputer di LMS {{ siteshortname }}
                    </h4>
                </div>
            </div>

            <div class="bento-tile tone-mint tile-side-article">
                <div class="side-thumb-wrap">
                    <div class="side-thumb-fallback bg-mint">
                        <i class="fa fa-id-card-o"></i>
                    </div>
                </div>
                <div class="side-article-body">
                    <div class="side-meta mb-1">
                        <span class="badge-cat badge-cat-mint">Layanan</span>
                        <span class="meta-date">Akun Siswa</span>
                    </div>
                    <h4 class="side-article-title">
                        Panduan Aktivasi dan Akses Tunggal Akun {{ siteshortname }}
                    </h4>
                </div>
            </div>

            <div class="bento-tile tone-amber tile-side-article">
                <div class="side-thumb-wrap">
                    <div class="side-thumb-fallback bg-amber">
                        <i class="fa fa-files-o"></i>
                    </div>
                </div>
                <div class="side-article-body">
                    <div class="side-meta mb-1">
                        <span class="badge-cat badge-cat-amber">Informasi</span>
                        <span class="meta-date">Semester Aktif</span>
                    </div>
                    <h4 class="side-article-title">
                        Penyelarasan Bahan Ajar dan Modul Digital Kurikulum Sekolah
                    </h4>
                </div>
            </div>
        </div>
    </div>

    <!-- —— Board 3: Katalog Kursus Pembelajaran (Transisi Mulus ke Kursus) —— -->
    <div id="katalog-kursus" class="courses-section-header pt-3 mb-3">
        <p class="bento-eyebrow">KATALOG PEMBELAJARAN</p>
        <h2 class="bento-section-title">Daftar Kursus & Kelas Terbuka</h2>
        <p class="section-lead-text">
            Pilih kelas di bawah ini untuk melihat silabus materi, atau masuk menggunakan akun {{ siteshortname }} Anda untuk mengikuti aktivitas pembelajaran penuh.
        </p>
    </div>
</div>
